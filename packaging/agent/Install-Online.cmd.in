@echo off
setlocal
chcp 65001 >nul
echo Đang tải gói Agent Windows từ GitHub Release v__VERSION__...
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $root=Join-Path $env:TEMP ('ITSupportToolkit-Agent-'+[guid]::NewGuid().ToString('N')); New-Item -Path $root -ItemType Directory -Force | Out-Null; try { [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $archive=Join-Path $root 'Agent.zip'; Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/thienhanaylai/Support-IT-Toolkit/releases/download/v__VERSION__/ITSupportToolkit-Agent-Windows.zip' -OutFile $archive; if ((Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash -ne '__SHA256__') { throw 'SHA-256 cua goi Agent khong khop. Dung cai dat.' }; $bundle=Join-Path $root 'bundle'; Expand-Archive -LiteralPath $archive -DestinationPath $bundle; & (Join-Path $bundle 'Install.cmd'); if ($LASTEXITCODE -ne 0) { throw 'Cai dat Agent that bai.' } } finally { Remove-Item -LiteralPath $root -Recurse -Force -ErrorAction SilentlyContinue }"
if errorlevel 1 (
  echo.
  echo Không thể cài Agent. Hãy tải ZIP Agent trên cùng trang Release,
  echo giải nén rồi chạy Install.cmd bên trong.
  pause
  exit /b 1
)
exit /b 0
